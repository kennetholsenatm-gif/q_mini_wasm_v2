{
  "identityProviders": [
    {
      "alias": "freeipa-ldap",
      "displayName": "FreeIPA LDAP Federation",
      "providerId": "ldap",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "config": {
        "priority": ["0"],
        "enabled": ["true"],
        "trustEmail": ["true"],
        "usePasswordModifyExtendedOp": ["false"],
        "editMode": ["WRITABLE"],
        "batchSizeForSync": ["1000"],
        "rdnLDAPAttribute": ["uid"],
        "uuidLDAPAttribute": ["ipaUniqueId"],
        "userObjectClasses": ["inetOrgPerson, organizationalPerson"],
        "connectionUrl": ["ldap://freeipa-server:389"],
        "usersDn": ["cn=users,cn=accounts,dc=qminiwasm,dc=local"],
        "authType": ["simple"],
        "bindDn": ["uid=admin,cn=users,cn=accounts,dc=qminiwasm,dc=local"],
        "bindCredential": ["${FREEIPA_ADMIN_PASSWORD}"],
        "customUserSearchFilter": ["(objectClass=person)"],
        "searchScope": ["1"],
        "validatePasswordPolicy": ["false"],
        "allowKerberosAuthentication": ["false"],
        "kerberosRealm": ["QMINIWASM.LOCAL"],
        "serverPrincipal": ["HTTP/localhost@QMINIWASM.LOCAL"],
        "keyTab": [""],
        "updateProfileFirstLogin": ["false"],
        "importEnabled": ["true"],
        "syncRegistrations": ["false"],
        "editMode": ["WRITABLE"],
        "vendor": ["rfc2307"],
        "usernameLDAPAttribute": ["uid"],
        "rdnLDAPAttribute": ["uid"],
        "uuidLDAPAttribute": ["ipaUniqueId"],
        "userObjectClasses": ["inetOrgPerson, organizationalPerson"],
        "connectionPooling": ["true"],
        "connectionPoolingAuthentication": ["none simple"],
        "connectionPoolingDebug": ["default"],
        "connectionPoolingInitSize": ["0"],
        "connectionPoolingMaxSize": ["50"],
        "connectionPoolingPrefSize": ["0"],
        "connectionPoolingProtocol": ["plain ssl"],
        "connectionPoolingTimeout": ["30000"],
        "connectionTimeout": ["30000"],
        "readTimeout": ["30000"],
        "pagination": ["true"],
        "allowKerberosAuthentication": ["false"],
        "kerberosServerPrincipal": ["HTTP/localhost@QMINIWASM.LOCAL"],
        "kerberosRealm": ["QMINIWASM.LOCAL"],
        "cachePolicy": ["DEFAULT"],
        "evictionDay": ["SUN"],
        "evictionHour": ["4"],
        "evictionMinute": ["0"],
        "maxLifespan": ["14400"]
      }
    },
    {
      "alias": "freeipa-kerberos",
      "displayName": "FreeIPA Kerberos Authentication",
      "providerId": "kerberos",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "config": {
        "priority": ["1"],
        "enabled": ["true"],
        "kerberosRealm": ["QMINIWASM.LOCAL"],
        "serverPrincipal": ["HTTP/localhost@QMINIWASM.LOCAL"],
        "keyTab": ["/opt/keycloak/conf/krb5.keytab"],
        "allowPasswordAuthentication": ["true"],
        "updateProfileFirstLogin": ["false"],
        "useKerberosForPasswordAuthentication": ["true"],
        "debug": ["false"],
        "allowKerberosAuthentication": ["true"],
        "cachePolicy": ["DEFAULT"],
        "evictionDay": ["SUN"],
        "evictionHour": ["4"],
        "evictionMinute": ["0"],
        "maxLifespan": ["14400"]
      }
    }
  ],
  "components": {
    "qminiwasm": {
      "name": "freeipa-ldap-storage",
      "providerId": "ldap",
      "providerType": "org.keycloak.storage.UserStorageProvider",
      "subType": "keycloak-ldap-federation",
      "parentId": "qminiwasm",
      "config": {
        "priority": ["100"],
        "enabled": ["true"],
        "fullSyncPeriod": ["604800"],
        "changedSyncPeriod": ["86400"],
        "cachePolicy": ["DEFAULT"],
        "evictionDay": ["SUN"],
        "evictionHour": ["4"],
        "evictionMinute": ["0"],
        "maxLifespan": ["14400"],
        "editMode": ["WRITABLE"],
        "importEnabled": ["true"],
        "syncRegistrations": ["false"],
        "vendor": ["rfc2307"],
        "usernameLDAPAttribute": ["uid"],
        "rdnLDAPAttribute": ["uid"],
        "uuidLDAPAttribute": ["ipaUniqueId"],
        "userObjectClasses": ["inetOrgPerson, organizationalPerson"],
        "connectionUrl": ["ldap://freeipa-server:389"],
        "usersDn": ["cn=users,cn=accounts,dc=qminiwasm,dc=local"],
        "authType": ["simple"],
        "bindDn": ["uid=admin,cn=users,cn=accounts,dc=qminiwasm,dc=local"],
        "bindCredential": ["${FREEIPA_ADMIN_PASSWORD}"],
        "customUserSearchFilter": ["(objectClass=person)"],
        "searchScope": ["1"],
        "validatePasswordPolicy": ["false"],
        "allowKerberosAuthentication": ["false"],
        "kerberosRealm": ["QMINIWASM.LOCAL"],
        "serverPrincipal": ["HTTP/localhost@QMINIWASM.LOCAL"],
        "keyTab": [""],
        "updateProfileFirstLogin": ["false"],
        "importEnabled": ["true"],
        "syncRegistrations": ["false"],
        "editMode": ["WRITABLE"],
        "vendor": ["rfc2307"],
        "usernameLDAPAttribute": ["uid"],
        "rdnLDAPAttribute": ["uid"],
        "uuidLDAPAttribute": ["ipaUniqueId"],
        "userObjectClasses": ["inetOrgPerson, organizationalPerson"],
        "connectionPooling": ["true"],
        "connectionPoolingAuthentication": ["none simple"],
        "connectionPoolingDebug": ["default"],
        "connectionPoolingInitSize": ["0"],
        "connectionPoolingMaxSize": ["50"],
        "connectionPoolingPrefSize": ["0"],
        "connectionPoolingProtocol": ["plain ssl"],
        "connectionPoolingTimeout": ["30000"],
        "connectionTimeout": ["30000"],
        "readTimeout": ["30000"],
        "pagination": ["true"],
        "allowKerberosAuthentication": ["false"],
        "kerberosServerPrincipal": ["HTTP/localhost@QMINIWASM.LOCAL"],
        "kerberosRealm": ["QMINIWASM.LOCAL"],
        "cachePolicy": ["DEFAULT"],
        "evictionDay": ["SUN"],
        "evictionHour": ["4"],
        "evictionMinute": ["0"],
        "maxLifespan": ["14400"]
      }
    }
  },
  "groups": [
    {
      "name": "Edge-Gateway-Admins",
      "path": "/Edge-Gateway-Admins",
      "attributes": {
        "description": ["Administrators for edge gateway deployments"],
        "ipaGroupType": ["posix"]
      }
    },
    {
      "name": "Quantum-Operators",
      "path": "/Quantum-Operators",
      "attributes": {
        "description": ["Operators for quantum computing resources"],
        "ipaGroupType": ["posix"]
      }
    },
    {
      "name": "Security-Admins",
      "path": "/Security-Admins",
      "attributes": {
        "description": ["Security administrators for the architecture"],
        "ipaGroupType": ["posix"]
      }
    }
  ],
  "clients": [
    {
      "clientId": "freeipa-integration",
      "name": "FreeIPA Integration Client",
      "description": "Client for FreeIPA integration with Keycloak",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${FREEIPA_INTEGRATION_SECRET}",
      "redirectUris": [
        "https://keycloak.qminiwasm.local/*",
        "https://localhost:8443/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://keycloak.qminiwasm.local/*"
      },
      "protocolMappers": [
        {
          "name": "FreeIPA Group Mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "access.token.claim": "true",
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "FreeIPA User Attribute Mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "access.token.claim": "true",
            "claim.name": "ipaUniqueId",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "ipaUniqueId"
          }
        }
      ]
    }
  ]
}