# VARLOCK Environment Schema for Autonomous Solace Agent Mesh
# This file defines the environment variables required for the deployment
# using @env-spec Domain Specific Language

@version: "1.0"
@description: "Environment variables for Autonomous Solace Agent Mesh infrastructure"
@compliance: "CMMC Level 2, Post-Quantum Cryptography Ready"

# Network Configuration
@env-spec: NETWORK_CONFIG
@description: "Network configuration for the mesh infrastructure"

MESH_NETWORK_SUBNET: string
@description: "Subnet for the mesh network using 100.64.0.0/10 range"
@default: "100.64.0.0/16"
@validation: "must be valid CIDR notation"

MESH_NETWORK_GATEWAY: string
@description: "Gateway IP for the mesh network"
@default: "100.64.0.1"
@validation: "must be valid IP address within subnet"

HOME_NETWORK_SUBNET: string
@description: "Home network subnet for NAT overload configuration"
@default: "192.168.1.0/24"
@validation: "must be valid CIDR notation"

# Database Configuration
@env-spec: DATABASE_CONFIG
@description: "Database configuration for OpenNebula and applications"

POSTGRES_DB: string
@description: "PostgreSQL database name"
@default: "one"
@validation: "must be valid database name"

POSTGRES_USER: string
@description: "PostgreSQL username"
@default: "oneadmin"
@validation: "must be valid username"

POSTGRES_PASSWORD: string
@description: "PostgreSQL password"
@sensitive: true
@required: true
@validation: "must be at least 12 characters with mixed case, numbers, and symbols"

POSTGRES_HOST: string
@description: "PostgreSQL host address"
@default: "opennebula-db"
@validation: "must be valid hostname or IP"

POSTGRES_PORT: integer
@description: "PostgreSQL port number"
@default: 5432
@validation: "must be valid port number (1-65535)"

# Solace Message VPN Configuration
@env-spec: SOLACE_CONFIG
@description: "Solace Message VPN configuration"

SOLACE_ADMIN_PASSWORD: string
@sensitive: true
@required: true
@description: "Solace admin password"
@validation: "must be at least 8 characters"

SOLACE_MESSAGE_VPN: string
@description: "Solace Message VPN name"
@default: "autonomous_agent_mesh"
@validation: "must be valid VPN name"

SOLACE_MTLS_ENABLED: boolean
@description: "Enable mTLS authentication for Solace"
@default: true

SOLACE_ACL_PROFILE: string
@description: "ACL profile name for Zero Trust configuration"
@default: "strict_a2a_profile"

# Gitea Configuration
@env-spec: GITEA_CONFIG
@description: "Gitea repository server configuration"

GITEA_USER_UID: integer
@description: "Gitea user UID"
@default: 1000
@validation: "must be valid UID"

GITEA_USER_GID: integer
@description: "Gitea user GID"
@default: 1000
@validation: "must be valid GID"

GITEA_DB_TYPE: string
@description: "Gitea database type"
@default: "postgres"
@validation: "must be 'postgres'"

GITEA_DB_HOST: string
@description: "Gitea database host"
@default: "opennebula-db:5432"

GITEA_DB_NAME: string
@description: "Gitea database name"
@default: "gitea"

GITEA_DB_USER: string
@description: "Gitea database user"
@default: "gitea"

GITEA_DB_PASSWORD: string
@sensitive: true
@required: true
@description: "Gitea database password"
@validation: "must be at least 8 characters"

GITEA_SECRET_KEY: string
@sensitive: true
@required: true
@description: "Gitea secret key for session encryption"
@validation: "must be at least 32 characters"

GITEA_INTERNAL_TOKEN: string
@sensitive: true
@required: true
@description: "Gitea internal token for API access"
@validation: "must be at least 64 characters"

GITEA_INSTALL_LOCK: boolean
@description: "Lock Gitea installation"
@default: true

# n8n Configuration
@env-spec: N8N_CONFIG
@description: "n8n workflow orchestrator configuration"

N8N_HOST: string
@description: "n8n host name"
@default: "n8n-orchestrator"

N8N_PORT: integer
@description: "n8n port number"
@default: 5678
@validation: "must be valid port number"

N8N_PROTOCOL: string
@description: "n8n protocol"
@default: "https"
@validation: "must be 'http' or 'https'"

N8N_SSL_KEY: string
@description: "n8n SSL private key path"
@default: "/data/n8n.key"

N8N_SSL_CERT: string
@description: "n8n SSL certificate path"
@default: "/data/n8n.crt"

N8N_DB_TYPE: string
@description: "n8n database type"
@default: "postgres"
@validation: "must be 'postgres'"

N8N_DB_HOST: string
@description: "n8n database host"
@default: "opennebula-db"

N8N_DB_PORT: integer
@description: "n8n database port"
@default: 5432
@validation: "must be valid port number"

N8N_DB_NAME: string
@description: "n8n database name"
@default: "n8n"

N8N_DB_USER: string
@description: "n8n database user"
@default: "n8n"

N8N_DB_PASSWORD: string
@sensitive: true
@required: true
@description: "n8n database password"
@validation: "must be at least 8 characters"

N8N_ENCRYPTION_KEY: string
@sensitive: true
@required: true
@description: "n8n encryption key"
@validation: "must be at least 32 characters"

N8N_WEBHOOK_URL: string
@description: "n8n webhook URL"
@default: "https://n8n-orchestrator:5678/webhook/"

# Vault Configuration
@env-spec: VAULT_CONFIG
@description: "Vault secrets management configuration"

VAULT_DEV_LISTEN_ADDRESS: string
@description: "Vault development listen address"
@default: "0.0.0.0:8200"

VAULT_DEV_ROOT_TOKEN_ID: string
@sensitive: true
@required: true
@description: "Vault development root token"
@validation: "must be at least 16 characters"

VAULT_SECRET_SHARES: integer
@description: "Number of Vault secret shares"
@default: 5
@validation: "must be between 1 and 10"

VAULT_SECRET_THRESHOLD: integer
@description: "Vault secret threshold for unsealing"
@default: 3
@validation: "must be between 1 and secret_shares"

# Post-Quantum Cryptography Configuration
@env-spec: PQC_CONFIG
@description: "Post-Quantum Cryptography configuration"

PQC_KEY_ALGORITHM: string
@description: "PQC key algorithm"
@default: "ECDSA"
@validation: "must be valid cryptographic algorithm"

PQC_ECDSA_CURVE: string
@description: "ECDSA curve for PQC"
@default: "P384"
@validation: "must be valid ECDSA curve"

PQC_CERT_VALIDITY_HOURS: integer
@description: "Certificate validity period in hours"
@default: 8760
@validation: "must be positive integer"

PQC_ML_KEM_KEY_LENGTH: integer
@description: "ML-KEM key length in bytes"
@default: 64
@validation: "must be positive integer"

PQC_PRIVATE_KEY_PATH: string
@description: "Path to PQC private key"
@default: "/opt/mesh/certs/ml_kem_private.key"

PQC_CERTIFICATE_PATH: string
@description: "Path to PQC certificate"
@default: "/opt/mesh/certs/mesh_cert.crt"

# Security Configuration
@env-spec: SECURITY_CONFIG
@description: "Security configuration for CMMC Level 2 compliance"

CMMC_LEVEL: string
@description: "CMMC compliance level"
@default: "Level 2"
@validation: "must be 'Level 1', 'Level 2', or 'Level 3'"

FIREWALL_DEFAULT_POLICY: string
@description: "Default firewall policy"
@default: "deny"
@validation: "must be 'allow' or 'deny'"

ALLOWED_SSH_SUBNETS: string
@description: "Comma-separated list of allowed SSH subnets"
@default: "192.168.1.0/24"
@validation: "must be valid CIDR notation"

ALLOWED_SERVICE_PORTS: string
@description: "Comma-separated list of allowed service ports"
@default: "22,80,443,3000,5678,8080,8200,9869,55555"
@validation: "must be valid port numbers"

ENABLE_IP_FORWARDING: boolean
@description: "Enable IP forwarding for NAT"
@default: true

ENABLE_IPTABLES_SAVE: boolean
@description: "Save iptables rules on shutdown"
@default: true

# Monitoring and Logging Configuration
@env-spec: MONITORING_CONFIG
@description: "Monitoring and logging configuration"

LOG_LEVEL: string
@description: "Application log level"
@default: "INFO"
@validation: "must be 'DEBUG', 'INFO', 'WARN', or 'ERROR'"

LOG_FORMAT: string
@description: "Log format"
@default: "json"
@validation: "must be 'json' or 'text'"

ENABLE_METRICS: boolean
@description: "Enable metrics collection"
@default: true

METRICS_PORT: integer
@description: "Metrics endpoint port"
@default: 9090
@validation: "must be valid port number"

ENABLE_AUDIT_LOGGING: boolean
@description: "Enable audit logging for compliance"
@default: true

AUDIT_LOG_PATH: string
@description: "Path for audit logs"
@default: "/var/log/mesh/audit.log"

# Deployment Configuration
@env-spec: DEPLOYMENT_CONFIG
@description: "Deployment configuration"

DEPLOYMENT_ENVIRONMENT: string
@description: "Deployment environment"
@default: "local"
@validation: "must be 'local', 'development', 'staging', or 'production'"

ENABLE_DEBUG_MODE: boolean
@description: "Enable debug mode for development"
@default: false

ENABLE_VERBOSE_LOGGING: boolean
@description: "Enable verbose logging"
@default: false

AUTO_START_SERVICES: boolean
@description: "Auto-start services on boot"
@default: true

ENABLE_BACKUPS: boolean
@description: "Enable automated backups"
@default: true

BACKUP_RETENTION_DAYS: integer
@description: "Number of days to retain backups"
@default: 30
@validation: "must be positive integer"

# Integration Configuration
@env-spec: INTEGRATION_CONFIG
@description: "External integration configuration"

GITEA_WEBHOOK_SECRET: string
@sensitive: true
@required: true
@description: "Gitea webhook secret for n8n integration"
@validation: "must be at least 32 characters"

N8N_WORKFLOW_IMPORT_PATH: string
@description: "Path to n8n workflow definitions"
@default: "/opt/mesh/configs/n8n_workflows.json"

SOLACE_CONFIG_PATH: string
@description: "Path to Solace configuration"
@default: "/opt/mesh/configs/solace_config.json"

VAULT_CONFIG_PATH: string
@description: "Path to Vault configuration"
@default: "/opt/mesh/configs/vault_init.json"

COMPLIANCE_CHECK_SCRIPT: string
@description: "Path to CMMC compliance check script"
@default: "/opt/mesh/scripts/cmmc_compliance.sh"

STATUS_DASHBOARD_PATH: string
@description: "Path to mesh status dashboard"
@default: "/opt/mesh/configs/mesh_status.html"

# Example usage:
# export MESH_NETWORK_SUBNET="100.64.0.0/16"
# export HOME_NETWORK_SUBNET="192.168.1.0/24"
# export POSTGRES_PASSWORD="your-secure-password-here"
# export SOLACE_ADMIN_PASSWORD="your-solace-password"
# export GITEA_SECRET_KEY="your-32-char-secret-key"
# export N8N_ENCRYPTION_KEY="your-32-char-encryption-key"
# export VAULT_DEV_ROOT_TOKEN_ID="your-vault-root-token"