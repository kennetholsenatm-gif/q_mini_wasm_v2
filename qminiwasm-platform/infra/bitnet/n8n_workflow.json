{
  "name": "BitNet LLM Integration Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bitnet/inference",
        "responseFormat": "json",
        "options": {
          "bodyContentType": "json",
          "jsonParameters": true,
          "bodyParametersJson": "{\"prompt\": \"{{ $json[\"prompt\"] }}\", \"max_length\": {{ $json[\"max_length\"] || 512 }}, \"temperature\": {{ $json[\"temperature\"] || 0.7 }}, \"top_p\": {{ $json[\"top_p\"] || 0.95 }}, \"top_k\": {{ $json[\"top_k\"] || 50 }}, \"repetition_penalty\": {{ $json[\"repetition_penalty\"] || 1.1 }}, \"do_sample\": {{ $json[\"do_sample\"] !== undefined ? $json[\"do_sample\"] : true }}}"
        },
        "url": "http://bitnet-llm:8000/inference",
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "Authorization",
          "value": "Bearer bitnet-local-token"
        }
      },
      "name": "BitNet Inference",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "notesInExecutionOrder": [
        {
          "message": "Send prompt to BitNet LLM for text generation",
          "timestamp": 1709577600000
        }
      ]
    },
    {
      "parameters": {
        "functionCode": "const prompt = $json[\"prompt\"];\nconst max_length = $json[\"max_length\"] || 512;\nconst temperature = $json[\"temperature\"] || 0.7;\nconst top_p = $json[\"top_p\"] || 0.95;\nconst top_k = $json[\"top_k\"] || 50;\nconst repetition_penalty = $json[\"repetition_penalty\"] || 1.1;\nconst do_sample = $json[\"do_sample\"] !== undefined ? $json[\"do_sample\"] : true;\n\nreturn {\n  prompt,\n  max_length,\n  temperature,\n  top_p,\n  top_k,\n  repetition_penalty,\n  do_sample\n};"
      },
      "name": "Prepare Inference Request",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
      "notesInExecutionOrder": [
        {
          "message": "Prepare and validate inference parameters",
          "timestamp": 1709577600000
        }
      ]
    },
    {
      "parameters": {
        "functionCode": "const response = $json[\"response\"];\nconst model = $json[\"model\"];\nconst inference_time = $json[\"inference_time\"];\nconst tokens_generated = $json[\"tokens_generated\"];\n\nreturn {\n  generated_text: response,\n  model_used: model,\n  inference_time_seconds: inference_time,\n  tokens_generated: tokens_generated,\n  timestamp: new Date().toISOString()\n};"
      },
      "name": "Process BitNet Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [
        800,
        300
      ],
      "notesInExecutionOrder": [
        {
          "message": "Process and format the BitNet response",
          "timestamp": 1709577600000
        }
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "bitnet/health",
        "responseFormat": "json",
        "url": "http://bitnet-llm:8000/health"
      },
      "name": "Check BitNet Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        200,
        100
      ],
      "notesInExecutionOrder": [
        {
          "message": "Check if BitNet service is healthy before processing",
          "timestamp": 1709577600000
        }
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json[\"status\"] }}",
              "operation": "equal",
              "value2": "healthy"
            }
          ]
        }
      },
      "name": "Is BitNet Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        400,
        100
      ],
      "notesInExecutionOrder": [
        {
          "message": "Check if BitNet service is healthy",
          "timestamp": 1709577600000
        }
      ]
    },
    {
      "parameters": {
        "functionCode": "return {\n  error: \"BitNet service is not healthy\",\n  status: $json[\"status\"],\n  timestamp: new Date().toISOString()\n};"
      },
      "name": "Handle Health Check Failure",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [
        600,
        50
      ],
      "notesInExecutionOrder": [
        {
          "message": "Handle case when BitNet service is not healthy",
          "timestamp": 1709577600000
        }
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "bitnet/model/info",
        "responseFormat": "json",
        "url": "http://bitnet-llm:8000/model/info"
      },
      "name": "Get Model Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        200,
        500
      ],
      "notesInExecutionOrder": [
        {
          "message": "Get information about the loaded model",
          "timestamp": 1709577600000
        }
      ]
    },
    {
      "parameters": {
        "functionCode": "const model_info = $json;\n\nreturn {\n  model_name: model_info.model_name,\n  model_version: model_info.model_version,\n  model_description: model_info.model_description,\n  device: model_info.device,\n  quantization_enabled: model_info.quantization_enabled,\n  max_length: model_info.max_length,\n  timestamp: new Date().toISOString()\n};"
      },
      "name": "Format Model Info",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [
        400,
        500
      ],
      "notesInExecutionOrder": [
        {
          "message": "Format model information for output",
          "timestamp": 1709577600000
        }
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "metrics",
        "responseFormat": "string",
        "url": "http://bitnet-llm:8001/metrics"
      },
      "name": "Get Prometheus Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        600,
        500
      ],
      "notesInExecutionOrder": [
        {
          "message": "Retrieve Prometheus metrics from BitNet service",
          "timestamp": 1709577600000
        }
      ]
    },
    {
      "parameters": {
        "functionCode": "const metrics = $json[\"response\"];\n\n// Parse Prometheus metrics\nconst lines = metrics.split('\\n');\nconst parsed_metrics = {};\n\nfor (const line of lines) {\n  if (line.startsWith('#') || line.trim() === '') continue;\n  \n  const [metric_name, value] = line.split(' ');\n  if (metric_name && value) {\n    parsed_metrics[metric_name] = parseFloat(value);\n  }\n}\n\nreturn {\n  metrics: parsed_metrics,\n  timestamp: new Date().toISOString()\n};"
      },
      "name": "Parse Metrics",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [
        800,
        500
      ],
      "notesInExecutionOrder": [
        {
          "message": "Parse Prometheus metrics into structured format",
          "timestamp": 1709577600000
        }
      ]
    }
  ],
