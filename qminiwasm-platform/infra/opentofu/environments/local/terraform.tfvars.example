# Optional: copy to terraform.tfvars to override. Do not commit terraform.tfvars (add to .gitignore).
# When using `make -C infra/opentofu local-up`, this file is used by default so no copy is required.
# Paths are relative to this file (environments/local) unless absolute.

kube_config_path = "./kubeconfig"

teleport_chart_version = "16.1.0"
# Local auth (no OIDC): use teleport-values-local.yaml so auth starts. For OIDC use teleport-values.yaml and create connector.
teleport_values_file   = "../../../teleport/teleport-values-local.yaml"
# teleport_timeout       = 900
teleport_wait          = false    # false for local so local-up completes; fix Teleport (e.g. auth PVC) and restart pods afterward
teleport_wait_for_jobs = false   # false for local when OIDC connector not created yet (lets local-up complete)

enable_wui = false
# When enable_wui = true, set path to charts/qminiwasm-wui (from repo root: ../../../../charts/qminiwasm-wui)
# wui_chart_path = "../../../../charts/qminiwasm-wui"

# MetalLB: IP pool for LoadBalancer services (anycast-style single IP per service). Default fits Kind Docker network.
# For DHCP subnet: use e.g. ["192.168.1.200-192.168.1.220"] and reserve that range in your DHCP server.
# metallb_address_pool = ["172.18.255.200-172.18.255.220"]
