# Inference image with OpenSCAP for compliance scanning (CIS, NIST).
# Build from repo root: docker build -f docker/Dockerfile.inference -t qminiwasm-inference:openscap .
# Run inference: same as containers/Dockerfile.serving; run OpenSCAP inside container when needed.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Install OpenSCAP scanner and SCAP content (Debian)
# libopenscap8 provides oscap; we fetch scap-security-guide from ComplianceAsCode releases
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenscap8 \
    openscap-utils \
    ca-certificates \
    curl \
    unzip \
    xmlsec1 \
    && rm -rf /var/lib/apt/lists/*

# SCAP Security Guide content: mount at runtime or use oscap --fetch-remote-resources.
# To bake in content, unzip ComplianceAsCode/content release into /usr/share/scap-security-guide.
ENV OSCAP_CONTENT_PATH=/usr/share/scap-security-guide
RUN mkdir -p "$OSCAP_CONTENT_PATH"

WORKDIR /app

COPY pyproject.toml setup.py ./
COPY requirements/ requirements/
COPY qminiwasm/ qminiwasm/
COPY engine/ engine/

RUN pip install --no-cache-dir -e . \
    && pip install --no-cache-dir -r requirements/core.txt -r requirements/quantum.txt -r requirements/wasm.txt \
    && pip install --no-cache-dir "fastapi>=0.104.0" "uvicorn[standard]>=0.24.0" "pydantic>=2.0.0"

RUN groupadd -r app --gid 1000 && useradd -r -u 1000 -g app -d /app -s /sbin/nologin app \
    && chown -R app:app /app

USER app
EXPOSE 8001
CMD ["python", "-m", "uvicorn", "engine.serve:app", "--host", "0.0.0.0", "--port", "8001"]
