{
  "project": "q_mini_wasm_v2",
  "version": "1.0.0",
  "description": "Discrete metrics for AutoLearn-improvable AI agent skills",
  
  "metrics_framework": {
    "collection_enabled": true,
    "baseline_established": false,
    "improvement_tracking": true,
    "regression_detection": true,
    "storage": "config/metrics-history.json"
  },
  
  "skill_metrics": {
    "quantum_core": {
      "description": "Metrics for quantum core development skill",
      "metrics": {
        "trit_operation_correctness": {
          "type": "accuracy",
          "description": "Percentage of trit operations returning correct GF(3) results",
          "measure": "passed_tests / total_tests",
          "target": 1.0,
          "current": 0.0,
          "discrete": true,
          "testable": true,
          "improvement_method": "test_and_fix"
        },
        "gf3_arithmetic_coverage": {
          "type": "coverage",
          "description": "Percentage of GF(3) arithmetic operations covered by tests",
          "measure": "tested_operations / total_operations",
          "target": 0.95,
          "current": 0.0,
          "discrete": true,
          "testable": true,
          "improvement_method": "add_tests"
        },
        "stabilizer_correctness_score": {
          "type": "accuracy",
          "description": "Correctness of stabilizer tableau operations",
          "measure": "correct_tableau_states / total_tested_states",
          "target": 1.0,
          "current": 0.0,
          "discrete": true,
          "testable": true,
          "improvement_method": "verify_and_correct"
        },
        "clifford_gate_accuracy": {
          "type": "accuracy",
          "description": "Accuracy of Clifford gate implementations (H, S, CSUM)",
          "measure": "correct_gates / total_gate_tests",
          "target": 1.0,
          "current": 0.0,
          "discrete": true,
          "testable": true,
          "improvement_method": "verify_gates"
        },
        "energy_efficiency_pj": {
          "type": "performance",
          "description": "Energy consumption in picojoules per operation",
          "measure": "total_energy / total_operations",
          "target": 1.0,
          "current": 0.0,
          "discrete": true,
          "testable": true,
          "improvement_method": "optimize_algorithms"
        }
      }
    },
    
