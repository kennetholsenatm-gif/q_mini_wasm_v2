{
  "project": "q_mini_wasm_v2",
  "development_workflows": {
    "feature_development": {
      "branch_naming": "feature/{module}-{description}",
      "required_modules": ["core", "tests"],
      "pre_commit_checks": [
        "clang_format_check",
        "trit_operation_validation",
        "stabilizer_correctness_check"
      ],
      "pr_requirements": {
        "code_review": "required",
        "quantum_expert_review": "recommended_for_core_changes",
        "test_coverage": ">=80%",
        "documentation_update": "required_for_api_changes"
      }
    },
    "bug_fix": {
      "branch_naming": "fix/{module}-{issue}",
      "required_checks": [
        "regression_tests",
        "quantum_correctness_validation",
        "gf3_arithmetic_verification"
      ]
    },
    "quantum_algorithm_change": {
      "branch_naming": "quantum/{algorithm}-{description}",
      "special_requirements": {
        "research_document_reference": "mandatory",
        "tableau_correctness_proof": "required",
        "energy_efficiency_analysis": "recommended",
        "expert_review": "required"
      }
    }
  },
  
  "build_workflows": {
    "cpp_build": {
      "cmake_config": {
        "build_types": ["Debug", "Release", "RelWithDebInfo"],
        "options": {
          "USE_SYCL": "optional",
          "BUILD_TESTS": "required",
          "BUILD_WASM": "optional"
        }
      },
      "platforms": {
        "windows": {
          "generator": "Visual Studio 17 2022",
          "compiler": "msvc"
        },
        "linux": {
          "generator": "Unix Makefiles",
          "compiler": "gcc_or_clang"
        }
      },
      "build_commands": {
        "configure": "cmake -S q_mini_wasm_v2 -B build -DCMAKE_BUILD_TYPE={build_type} -DBUILD_TESTS=ON",
        "build": "cmake --build build --config {build_type} -j$(nproc)",
        "test": "ctest --build-config {build_type} --output-on-failure"
      }
    },
    "go_build": {
      "modules": ["gateway", "engine"],
      "build_commands": {
        "build": "go build -o bin/gateway.exe ./cmd/gateway",
        "test": "go test -v -race ./...",
        "lint": "golangci-lint run"
      },
      "cgo_requirements": {
        "header": "q_mini_wasm_v2/dll/q_mini_wasm_v2_api.hpp",
        "link_flags": "-lq_mini_wasm_v2_core"
      }
    },
    "wasm_build": {
      "toolchain": "emscripten",
      "build_commands": {
        "configure": "emcmake cmake -S q_mini_wasm_v2 -B wasm_build -DBUILD_WASM=ON",
        "build": "cmake --build wasm_build",
        "optimize": "wasm-opt -O3 -o output.wasm input.wasm"
      }
    }
  },
  
  "ci_cd_workflows": {
    "continuous_integration": {
      "trigger": "push_to_main_or_develop",
      "jobs": [
        {
          "name": "lint",
          "steps": ["clang_format", "static_analysis"]
        },
        {
          "name": "build_matrix",
          "platforms": ["windows-latest", "ubuntu-latest"],
          "configurations": ["Debug", "Release"]
        },
        {
          "name": "test",
          "requires": "build_matrix",
          "steps": ["unit_tests", "integration_tests"]
        },
        {
          "name": "sycl_build",
          "optional": true,
          "steps": ["check_sycl_availability", "build_with_sycl", "test_sycl"]
        }
      ]
    },
    "release_workflow": {
      "trigger": "tag_push_v*",
      "jobs": [
        {
          "name": "build_release",
          "steps": [
            "build_native",
            "generate_sbom",
            "create_tarball"
          ]
        },
        {
          "name": "create_github_release",
          "requires": "build_release",
          "artifacts": ["*.tar.gz", "sbom-spdx.json"]
        }
      ]
    }
  },
  
  "quantum_specific_workflows": {
    "tableau_validation": {
      "description": "Validate qutrit stabilizer tableau correctness",
      "steps": [
        "compile_with_debug_symbols",
        "run_stabilizer_tests",
        "verify_clifford_operations",
        "check_gottesman_knill_compliance",
        "generate_correctness_report"
      ]
    },
    "energy_efficiency_analysis": {
      "description": "Analyze energy consumption of quantum operations",
      "metrics": [
        "picojoules_per_operation",
        "comparison_to_fp32",
        "syll_acceleration_factor"
      ]
    }
  }
}
