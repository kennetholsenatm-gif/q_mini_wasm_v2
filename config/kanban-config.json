{
  "project": "q_mini_wasm_v2",
  "version": "2.0.0",
  "description": "Kanban configuration for RAG and MCP server integration with AI agents",
  "mcp_servers": [
    "qminiwasm-rag-service",
    "qminiwasm-autolearn",
    "qminiwasm-core-cpp",
    "qminiwasm-dll-bridge",
    "qminiwasm-go-runtime",
    "qminiwasm-runtime-engine",
    "qminiwasm-sycl-accelerator",
    "qminiwasm-test-orchestrator",
    "qminiwasm-wui-designer"
  ],
  "rag_service": {
    "enabled": true,
    "server": "qminiwasm-rag-service",
    "tools": [
      "rag_retrieve_context",
      "rag_index_document",
      "rag_get_metrics",
      "rag_reindex_all",
      "kanban_rag_status"
    ]
  },
  "ai_models": {
    "enabled": true,
    "model_server": "http://127.0.0.1:3485",
    "primary_model": "cline-kanban-agent",
    "available_models": [
      {
        "id": "cline-kanban-agent",
        "name": "ClineKanbanAgent",
        "version": "1.0.0",
        "accuracy": 0.9868,
        "type": "primary_kanban_model"
      },
      {
        "id": "analysis-agent",
        "name": "AnalysisAgent",
        "version": "2.0.0",
        "accuracy": 0.98,
        "type": "production_agent"
      },
      {
        "id": "code-agent",
        "name": "CodeAgent",
        "version": "2.0.0",
        "accuracy": 0.98,
        "type": "production_agent"
      },
      {
        "id": "test-agent",
        "name": "TestAgent",
        "version": "2.0.0",
        "accuracy": 0.98,
        "type": "production_agent"
      }
    ]
  },
  "kanban_integration": {
    "enabled": true,
    "status_tracking": {
      "quantum_core": "kanban_quantum_status",
      "dll_bridge": "kanban_dll_pipeline",
      "go_runtime": "kanban_go_status",
      "rag_service": "kanban_rag_status",
      "runtime_engine": "kanban_runtime_status",
      "sycl_accelerator": "kanban_sycl_status",
      "test_orchestrator": "kanban_test_gate",
      "wui_designer": "kanban_wui_status"
    },
    "pipeline_gates": {
      "code_review": "required",
      "quantum_expert_review": "recommended_for_core",
      "test_coverage": ">=80%",
      "energy_efficiency": "validate_pj_targets",
      "autolearn_validation": "required_for_improvements"
    }
  }
}