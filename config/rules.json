{
  "project": "q_mini_wasm_v2",
  "version": "1.0.0",
  "description": "Quantum-Classical Hybrid Framework with Ternary Neural Networks",
  
  "coding_standards": {
    "cpp": {
      "standard": "C++17",
      "compiler_requirements": {
        "gcc": ">=7",
        "clang": ">=5",
        "msvc": ">=2017"
      },
      "style": {
        "naming_convention": "snake_case",
        "header_guard": "pragma_once",
        "indentation": "4_spaces",
        "line_length": 120,
        "brace_style": "allman"
      },
      "quantum_specific": {
        "trit_operations": {
          "allowed_values": [-1, 0, 1],
          "arithmetic_field": "GF(3)",
          "modulo_operations": "mandatory_for_all_trit_arithmetic",
          "no_floating_point": true
        },
        "tableau_operations": {
          "complexity_bound": "O(n^2)",
          "must_track_inverse_stability": true,
          "gottesman_knill_compliance": true
        },
        "stabilizer_rules": {
          "validate_clifford_gates": ["CSUM", "Hadamard", "Phase", "Pauli"],
          "preserve_stabilizer_formalism": true,
          "check_entanglement_entropy": true
        }
      }
    },
    "go": {
      "version": ">=1.26",
      "modules": {
        "naming": "github.com/q_mini_wasm_v2/*",
        "cgo_bindings": "required_for_qutrit_engine"
      },
      "error_handling": "explicit_error_returns",
      "concurrency": "goroutines_and_channels"
    },
    "wasm": {
      "target": "emscripten",
      "memory_management": "dynamic_growth",
      "max_memory": "4GB",
      "threading": "pthreads"
    }
  },
  
  "architecture_rules": {
    "module_separation": {
      "core": "pure_cpp_quantum_operations",
      "runtime": "async_orchestration",
      "sycl": "gpu_acceleration_optional",
      "dll": "api_exports_and_bindings",
      "go": "gateway_and_services",
      "wui": "visualization_interface"
    },
    "dependency_rules": {
      "core_must_be_self_contained": true,
      "no_circular_dependencies": true,
      "quantum_logic_isolation": "strict"
    }
  },
  
  "testing_rules": {
    "coverage_requirements": {
      "unit_tests": ">=80%",
      "integration_tests": "required",
      "quantum_correctness_tests": "mandatory"
    },
    "test_categories": [
      "trit_operations",
      "gf3_arithmetic",
      "stabilizer_correctness",
      "clifford_gate_verification",
      "moe_routing_validation",
      "forward_forward_learning",
      "sycl_kernels"
    ]
  },
  
  "documentation_rules": {
    "cognitive_ergonomics_compliance": true,
    "api_documentation": "auto_generated_from_headers",
    "research_references": "required_for_quantum_algorithms",
    "visual_hierarchy": "gestalt_principles"
  },
  
  "security_rules": {
    "memory_safety": "bounds_checking_required",
    "input_validation": "strict_for_all_external_inputs",
    "quantum_state_isolation": "prevent_classical_contamination"
  }
}
