        "performance_tests": {
          "weight": 0.20,
          "tests": [
            "request_latency",
            "throughput_under_load",
            "memory_efficiency"
          ],
          "passing_score": 0.85
        },
        "integration_tests": {
          "weight": 0.15,
          "tests": [
            "quantum_engine_integration",
