{
  "project": "q_mini_wasm_v2",
  "version": "1.0.0",
  "description": "AutoLearn School evaluation framework for testing AI agent improvements",
  
  "evaluation_framework": {
    "enabled": true,
    "mode": "continuous",
    "evaluation_frequency": "per_improvement_cycle",
    "passing_threshold": 0.85,
    "regression_threshold": 0.05
  },
  
  "teacher_agent": {
    "name": "self_learning",
    "role": "Evaluate student agents and provide improvement guidance",
    "evaluation_methods": [
      "test_validation",
      "metric_comparison",
      "pattern_analysis",
      "regression_detection"
    ],
    "memory_access": "full_project_context",
    "learning_sources": [
      "git_history",
      "test_results",
      "build_logs",
      "metric_trends"
    ]
  },
  
  "student_evaluations": {
    "quantum_core": {
      "evaluation_criteria": {
        "correctness_tests": {
          "weight": 0.35,
          "tests": [
            "trit_operations_gf3",
            "stabilizer_tableau_correctness",
            "clifford_gate_properties",
            "entanglement_entropy_calculation"
          ],
          "passing_score": 0.95
        },
        "performance_tests": {
          "weight": 0.25,
          "tests": [
            "tableau_update_complexity",
            "energy_efficiency_benchmark",
            "memory_usage_optimization"
          ],
          "passing_score": 0.85
        },
        "coverage_tests": {
          "weight": 0.20,
          "tests": [
            "gf3_arithmetic_coverage",
            "edge_case_handling",
            "error_condition_coverage"
          ],
          "passing_score": 0.80
        },
        "integration_tests": {
          "weight": 0.20,
          "tests": [
            "moe_router_integration",
            "forward_forward_learning",
            "orchestrator_async_operations"
          ],
          "passing_score": 0.90
        }
      },
      "improvement_triggers": [
        "test_failure",
        "performance_regression",
        "coverage_drop",
        "energy_efficiency_degradation"
      ]
    },
    
    "dll_bridge": {
      "evaluation_criteria": {
        "correctness_tests": {
          "weight": 0.40,
          "tests": [
            "type_mapping_accuracy",
            "memory_safety_validation",
            "api_signature_preservation"
          ],
          "passing_score": 0.98
        },
        "coverage_tests": {
          "weight": 0.30,
          "tests": [
            "api_exposure_coverage",
            "language_binding_completeness",
            "error_propagation_coverage"
          ],
          "passing_score": 0.90
        },
        "integration_tests": {
          "weight": 0.30,
          "tests": [
            "go_cgo_integration",
            "python_ctypes_integration",
            "wasm_binding_integration"
          ],
          "passing_score": 0.95
        }
      },
      "improvement_triggers": [
        "binding_generation_failure",
        "type_mapping_error",
        "memory_leak_detected",
        "api_coverage_drop"
      ]
    },
    
    "go_runtime": {
      "evaluation_criteria": {
        "correctness_tests": {
          "weight": 0.35,
          "tests": [
            "cgo_binding_accuracy",
