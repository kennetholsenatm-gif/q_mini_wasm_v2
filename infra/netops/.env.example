# NetBox: copy to .env and set values (do not commit .env)
# POSTGRES_* are used by NetBox's postgres service.
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=changeme_netbox_db

# Redis (Valkey) password for NetBox session/cache
REDIS_PASSWORD=changeme_redis

# NetBox superuser (create via 'python manage.py createsuperuser' or set at first run)
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=changeme_netbox_admin

# Netdisco: DB and admin (if using shared or external DB, set NETDISCO_DB_*)
NETDISCO_DB_HOST=netdisco-postgresql
NETDISCO_DB_NAME=netdisco
NETDISCO_DB_USER=netdisco
NETDISCO_DB_PASS=changeme_netdisco_db
NETDISCO_DB_SUPERUSER=changeme_netdisco_super
DEPLOY_ADMIN_USER=YES
NETDISCO_ADMIN_USER=admin

# Optional: NetBox API token for Ansible dynamic inventory
# NETBOX_TOKEN=your_netbox_api_token
# NETBOX_URL=http://netbox:8000
