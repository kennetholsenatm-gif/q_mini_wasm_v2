# Edge Gateway / Agent Mesh – example environment variables.
# In production, source these from HashiCorp Vault (inject at container start or via Ansible).

# --- Solace broker (central event mesh over VPN) ---
SOLACE_BROKER_URL=
SOLACE_BROKER_USERNAME=
SOLACE_BROKER_PASSWORD=
SOLACE_BROKER_VPN=default
SOLACE_DEV_MODE=false

# --- LLM service (optional, for agent reasoning) ---
LLM_SERVICE_GENERAL_MODEL_NAME=
LLM_SERVICE_ENDPOINT=
LLM_SERVICE_API_KEY=

# --- Wazuh (security-ids container) ---
WAZUH_API_URL=http://security-ids:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=

# --- Zabbix proxy (local telemetry) ---
ZABBIX_API_URL=http://localhost/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=

# --- Netdisco (topology, LLDP/CDP, MAC-to-port) ---
NETDISCO_API_URL=http://localhost:5000
NETDISCO_API_KEY=
# Or use login (NETDISCO_API_KEY preferred to avoid login on every request):
NETDISCO_USER=
NETDISCO_PASSWORD=

# --- Foreman (infrastructure lifecycle) ---
FOREMAN_API_URL=
FOREMAN_API_TOKEN=
# Or basic auth:
FOREMAN_USER=
FOREMAN_PASSWORD=

# --- Graylog (log search) ---
GRAYLOG_API_URL=http://localhost:9000
GRAYLOG_USER=
GRAYLOG_PASSWORD=
