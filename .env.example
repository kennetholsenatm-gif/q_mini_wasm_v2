# Copy to .env (gitignored). python-dotenv loads this for `python -m qminiwasm.engine` and `uvicorn qminiwasm.engine.serve:app`.
#
# Put secrets and deployment-only overrides here. Training hyperparameters, HF dataset options, WASM
# limits, and hardware accelerators belong in versioned TOML under configs/training/ (see
# docs/TRAINING_DATA.md). Run: python -m qminiwasm.engine --config configs/training/<name>.toml
# Optional: python -m qminiwasm.engine --config ... --log-level DEBUG   (else LOG_LEVEL below)
#
# Hugging Face Hub (optional; rate limits / gated datasets). Raw token only — no extra quotes/braces.
# HUGGING_FACE_HUB_TOKEN=hf_...
# HF_TOKEN=
#
# IBM Quantum (optional; qiskit_ibm QAOA — see docs/QUANTUM_QISKIT.md)
# IBM_QUANTUM_API_TOKEN=
# IBM_BACKEND_NAME=ibm_torino
#
# RunPod (optional): OpenTofu stack under infra/runpod — see docs/RUNPOD_QUICKSTART.md
# Create API key: https://www.runpod.io/console/user/settings
# infra/runpod/tofu.sh maps RUNPOD_TOKEN -> RUNPOD_API_KEY when unset.
# After editing .env, restart training-wui so /api/runpod/* sees the token.
# RUNPOD_TOKEN=
# RUNPOD_API_KEY=
# Remote training from training-wui (Launch with RunPod + “Train on RunPod GPU”): SSH into the pod after apply.
# RUNPOD_SSH_USER=root
# RUNPOD_REMOTE_DIR=/workspace/qminiwasm-core
# RUNPOD_SSH_KEY=C:\Users\you\.ssh\id_ed25519   # or ~/.ssh/id_rsa — path on the WUI machine
#
# RunPod Serverless (optional): queue-based GPU workers — see docs/RUNPOD_SERVERLESS.md
# Queue API (https://api.runpod.ai/v2/.../run): prefer endpoint key, else account key.
# RUNPOD_TOKEN_END=          # Endpoint API key from RunPod console (optional; overrides account key for /run|/status|/health)
# Uses RUNPOD_API_KEY / RUNPOD_TOKEN if RUNPOD_TOKEN_END is unset. Management API (rest.runpod.io) uses account key only.
# RUNPOD_SERVERLESS_ENDPOINT_ID=
# Worker image for auto-created templates: set [runpod_serverless] worker_image in configs/training/*.toml (see docs/RUNPOD_SERVERLESS.md).
#
# Inference (uvicorn qminiwasm.engine.serve:app — see qminiwasm/engine/serve.py)
# QMINIWASM_SERVE_CONFIG=configs/serve/default.toml
# QMINIWASM_CHECKPOINT=./artifacts/models/<slug>/best.pt
#
# Optional process default when --log-level is not passed to python -m qminiwasm.engine
# LOG_LEVEL=INFO
#
# Wasmtime store linear-memory cap (optional). Overrides [wasm] store_memory_limit_mb and code default.
# Use if logs still show 268435456 (256 MiB): image may be on an older package — set bytes to match 1e6×d_model:
# QMW_WASM_STORE_MEMORY_LIMIT_BYTES=4096000000
# QMW_WASM_STORE_MEMORY_LIMIT_MB=3907
# QMINIWASM_WASM_BACKEND=wasmtime
# QMINIWASM_WASM_FALLBACK_POLICY=mock
# QMINIWASM_STRICT_CONFIG_VALIDATION=0
# QMINIWASM_ASSERT_ZERO_MOCK_RATIO=0
#
# Native / toolchain (build-time or advanced; not training TOML)
# QMINIWASM_BUILD_NATIVE=1
# WASI_SDK_PATH=C:/wasi-sdk-24.0
#
# C++ training engine (vcpkg + CMake — see cpp/training/README.md and scripts/start_cpp_training_engine.*)
# Clone microsoft/vcpkg next to this repo (e.g. C:\GitHub\LLM_Pract\vcpkg), bootstrap, then:
#   vcpkg install grpc:x64-windows protobuf:x64-windows
# Point one of these at that clone so scripts/start_cpp_training_engine.ps1 passes CMAKE_TOOLCHAIN_FILE:
# VCPKG_ROOT=C:\GitHub\LLM_Pract\vcpkg
# CMAKE_TOOLCHAIN_FILE=C:\GitHub\LLM_Pract\vcpkg\scripts\buildsystems\vcpkg.cmake
# Optional override for training-wui gRPC client (default 127.0.0.1:50061):
# QMINIWASM_TRAINING_GRPC_ADDR=127.0.0.1:50061
