# Copy to .env and fill in (never commit .env — it is gitignored).
# With pip install -e ".[training]", python-dotenv loads this file for python -m engine and serve.
#
# Primary training hyperparameters live in versioned TOML under configs/training/ (see docs/TRAINING_DATA.md).
# Run: python -m engine --config configs/training/mesh_cpu.toml
# Omitting --config still reads this file + env for all settings (deprecated; emits a warning).
# Keep tokens and optional deployment overrides here (HUGGING_FACE_HUB_TOKEN, ACCELERATOR in containers, …).
#
# Inference TOML (optional): QMINIWASM_SERVE_CONFIG=configs/serve/default.toml — see engine/serve.py docstring.
#
# Hugging Face Hub — optional; improves rate limits and enables gated datasets.
# Prefer the official name; HF_TOKEN is accepted as a fallback in EngineConfig.
# Use the raw token only — do not wrap in "quotes" or {curly braces} (providers reject that).
# HUGGING_FACE_HUB_TOKEN=hf_your_token_here
# HF_TOKEN=
# IBM Quantum (optional): IBM_QUANTUM_API_TOKEN=...  (same rule: no extra quotes or braces)
# IBM_BACKEND_NAME=ibm_torino   # required for qiskit_ibm QAOA mode
# QUANTUM_EXECUTION_POLICY=prefer_hardware_fallback   # WUI: hardware_only | prefer_hardware_fallback | simulator_only
# hardware_only upgrades default pennylane -> qiskit_ibm so HybridQuantumMoE uses IBM (needs token + IBM_BACKEND_NAME)
# QMINIWASM_QAOA_EXECUTION=pennylane   # or qiskit_statevector | qiskit_ibm (see docs/QUANTUM_QISKIT.md)
# QMINIWASM_IBM_FALLBACK_STATEVECTOR=1   # when qiskit_ibm fails (quota/usage limit), fall back to local statevector (0=off)
# IBM_QAOA_SHOTS=1024
#
# Runpod — use RUNPOD_TOKEN in .env (repo convention). OpenTofu/Terraform provider expects RUNPOD_API_KEY;
# infra/runpod/tofu.sh maps RUNPOD_TOKEN -> RUNPOD_API_KEY when unset. Spin up/down: cd infra/runpod && ./tofu.sh apply|destroy
# Training WUI RunPod mode: install OpenTofu so `tofu` is on PATH (same as `terraform`). Incus: training-wui/incus/install-opentofu.sh
# https://opentofu.org/docs/intro/install/
# RUNPOD_TOKEN=
# RUNPOD_API_KEY=
# HF_DATASET_REVISION=main
#
# Richer HF rows: labeled [context] prefix (auto mode). Disable: HF_CONTEXT_FIELDS=0
# HF_CONTEXT_FIELDS=language,func_name,repo,path
#
# 100k WASI-flavored HF slice (streaming; TRAINING_DATA_SOURCE=hf_tabular, DATA_PATH=code-search-net/code_search_net)
# HF_NUM_SAMPLES=100000
# HF_WASI_SLICE_ONLY=1
# HF_WASI_MAX_SCAN=12000000
# Append mesh curriculum rows as a fraction of HF row count (WASM/synthetic diversity; 0=off)
# HF_MESH_BLEND_FRACTION=0.1
#
# Intel Iris Xe / Arc — PyTorch training (install XPU torch first: docs/INSTALL_TORCH_XPU.md)
# ACCELERATOR=xpu
# python scripts/verify_torch_xpu.py
#
# WASM C toolchain — default bare wasm32; wasi-sdk for wasm32-wasip1 mesh compile
# QMINIWASM_WASM_C_LINK=bare
# WASI_SDK_PATH=C:/wasi-sdk-24.0
#
# SYCL (dpctl) — optional; requires oneAPI runtime on PATH
# ONEAPI_DEVICE_SELECTOR=level_zero:gpu
# QMINIWASM_SYCL_DEVICE=level_zero:gpu:0
# QMINIWASM_SYCL_PREFER_GPU=1
#
# Training checkpoints & holdout eval
# CHECKPOINT_SAVE_PATH=./artifacts/qminiwasm_trainable.pt
# CHECKPOINT_BEST_PATH=./artifacts/qminiwasm_best.pt
# CHECKPOINT_LATEST_PATH=./artifacts/qminiwasm_latest.pt
# CHECKPOINT_LOAD_PATH=
# EVAL_HOLDOUT_FRACTION=0.05
# EVAL_EVERY_EPOCH=1
#
# Mean MSE goal (same scale as logged mean_mse / eval_mean_mse; PyTorch mean over all elements).
# hf_tabular defaults TARGET_MEAN_MSE=1e-4, GRAD_CLIP_NORM=1, CASCADE_POLICY_LR=0.5*LEARNING_RATE,
# and LEARNING_RATE=1.5e-4 when LEARNING_RATE env unset and ctor default 1e-4.
# TARGET_MEAN_MSE=1e-4
# STOP_ON_TARGET_MSE=1
#
# Cascade RL (GRPO toy routing MDP) — runs before each epoch’s supervised MSE phase; on by default.
# CASCADE_RL=0
# CASCADE_POLICY_LR=1e-4
# CASCADE_STEPS_PER_EPOCH=2
# CASCADE_GROUP_SIZE=4
# CASCADE_STATE_DIM=8
# CASCADE_NUM_ACTIONS=4
# CASCADE_MOPD_LAMBDA=0
# When CASCADE_MOPD_LAMBDA > 0: feature loss for synthetic teacher (state vs state+noise); mse or cosine
# CASCADE_MOPD_FEAT_LOSS=mse
# CASCADE_SEED_FROM_HIDDEN=0
# USE_CASCADE_ROUTER=0
# CASCADE_LEARNED_PROJECTOR=0
# CASCADE_ROUTER_HIDDEN=32
# CASCADE_COUPLE_FORWARD=0
#
# --- Next run: Cascade RL + MOPD (continuation experiment) ---
# Full recipe + metrics: docs/CASCADE_AND_MOPD.md (Recommended continuation run).
# Keep SEED, BATCH_SIZE, HF_*, HYBRID_ADAPTER, ACCELERATOR, LEARNING_RATE / LR_PLATEAU_* aligned with
# your baseline run for a fair A/B comparison.
#
# Phase A — MOPD on (synthetic teacher: state vs state+noise; regularizes cascade head)
# Start CASCADE_MOPD_LAMBDA in 0.05–0.1; raise toward 0.2 only if train MSE stays stable.
# CASCADE_MOPD_LAMBDA=0.1
# CASCADE_MOPD_FEAT_LOSS=mse
# Optional second experiment: CASCADE_MOPD_FEAT_LOSS=cosine
# Optional more cascade signal per epoch (wall-clock): CASCADE_STEPS_PER_EPOCH=3
#
# Phase B — align cascade with inference (only if you want cascade_logits on POST /infer)
# Train and serve with the same USE_CASCADE_ROUTER and CASCADE_* dims.
# USE_CASCADE_ROUTER=1
# CASCADE_STATE_DIM=8
# CASCADE_NUM_ACTIONS=4
# CASCADE_ROUTER_HIDDEN=32
# Alternative without model router: CASCADE_LEARNED_PROJECTOR=1 (no per-row cascade_logits on serve)
#
# Phase C — warm start from best baseline checkpoint (use YOUR paths; do not overwrite baseline)
# CHECKPOINT_LOAD_PATH=./artifacts/qminiwasm_best_baseline.pt
# CHECKPOINT_SAVE_PATH=./artifacts/qminiwasm_trainable_cascade_mopd.pt
# CHECKPOINT_BEST_PATH=./artifacts/qminiwasm_best_cascade_mopd.pt
# CHECKPOINT_LATEST_PATH=./artifacts/qminiwasm_latest_cascade_mopd.pt
#
# Optional: holdout eval MSE each epoch (not in optimizer)
# EVAL_HOLDOUT_FRACTION=0.05
# EVAL_EVERY_EPOCH=1
#
# If train mean MSE worsens or cascade loss spikes: lower CASCADE_MOPD_LAMBDA or CASCADE_POLICY_LR.
#
# Or run: python scripts/run_training_cascade_mopd.py [--dry-run] [--help]
# Resume from latest in one step: python scripts/resume_training_cascade_mopd.py
# (loads .env then injects CASCADE_MOPD_* and default checkpoint output paths)

# Extra capacity: residual MLP after ternary (4096 → hidden → 4096), checkpointed as hybrid_adapter
# HYBRID_ADAPTER=1
# HYBRID_ADAPTER_HIDDEN=1024
#
# Inference (uvicorn engine.serve:app)
# QMINIWASM_CHECKPOINT=./artifacts/qminiwasm_trainable.pt
# USE_CASCADE_ROUTER=1
# CASCADE_STATE_DIM=8
# CASCADE_NUM_ACTIONS=4
