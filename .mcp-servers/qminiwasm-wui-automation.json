{
  "name": "qminiwasm-wui-automation",
  "description": "MCP server for desktop WUI automation - MCP-host bridge control surface for q_mini_wasm_v2",
  "tools": [
    {
      "name": "wui_connect",
      "description": "Initialize MCP bridge session to backend engine",
      "input_schema": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "default": "localhost",
            "description": "Bridge host metadata (default localhost)"
          },
          "port": {
            "type": "integer",
            "default": 8080,
            "description": "Bridge port metadata (default 8080)"
          },
          "timeout_ms": {
            "type": "integer",
            "default": 5000,
            "description": "Connection timeout in milliseconds"
          }
        }
      }
    },
    {
      "name": "wui_disconnect",
      "description": "Close MCP bridge session",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "wui_system_self_check",
      "description": "Run startup readiness checks for desktop WUI and release pipeline",
      "input_schema": {
        "type": "object",
        "properties": {
          "expect_artifact": {
            "type": "string",
            "description": "Optional artifact path to validate"
          }
        }
      }
    },
    {
      "name": "wui_get_system_toml",
      "description": "Read authoritative config/system.toml payload",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "wui_set_system_toml",
      "description": "Validate and persist authoritative config/system.toml payload",
      "input_schema": {
        "type": "object",
        "properties": {
          "toml": {
            "type": "string",
            "description": "Full TOML document to persist"
          }
        },
        "required": ["toml"]
      }
    },
    {
      "name": "wui_validate_system_toml",
      "description": "Validate TOML payload and required [system.*] governance sections",
      "input_schema": {
        "type": "object",
        "properties": {
          "toml": {
            "type": "string",
            "description": "Optional TOML content to validate; defaults to file"
          },
          "path": {
            "type": "string",
            "description": "Optional path for TOML validation target"
          }
        }
      }
    },
    {
      "name": "wui_desktop_shell_handshake",
      "description": "Return desktop shell contract details and optionally extract embedded asset bundle",
      "input_schema": {
        "type": "object",
        "properties": {
          "artifact_path": {
            "type": "string",
            "description": "Optional desktop artifact path"
          },
          "extract_dir": {
            "type": "string",
            "description": "Optional extraction directory for embedded assets"
          },
          "extract_assets": {
            "type": "boolean",
            "default": false,
            "description": "If true, extract and verify embedded assets"
          }
        }
      }
    },
    {
      "name": "wui_apply_hadamard",
      "description": "Apply Hadamard gate to specified qutrit (creates superposition in GF(3))",
      "input_schema": {
        "type": "object",
        "properties": {
          "qutrit_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Target qutrit index"
          },
          "await_result": {
            "type": "boolean",
            "default": true,
            "description": "Wait for operation completion"
          }
        },
        "required": ["qutrit_index"]
      }
    },
    {
      "name": "wui_apply_phase",
      "description": "Apply Phase gate (S gate) to specified qutrit (adds phase in GF(3))",
      "input_schema": {
        "type": "object",
        "properties": {
          "qutrit_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Target qutrit index"
          },
          "await_result": {
            "type": "boolean",
            "default": true,
            "description": "Wait for operation completion"
          }
        },
        "required": ["qutrit_index"]
      }
    },
    {
      "name": "wui_apply_csum",
      "description": "Apply Controlled-SUM gate between two qutrits (entangling operation)",
      "input_schema": {
        "type": "object",
        "properties": {
          "control": {
            "type": "integer",
            "minimum": 0,
            "description": "Control qutrit index"
          },
          "target": {
            "type": "integer",
            "minimum": 0,
            "description": "Target qutrit index"
          },
          "await_result": {
            "type": "boolean",
            "default": true,
            "description": "Wait for operation completion"
          }
        },
        "required": ["control", "target"]
      }
    },
    {
      "name": "wui_apply_pauli_x",
      "description": "Apply Pauli-X gate (shift/NOT operation in GF(3))",
      "input_schema": {
        "type": "object",
        "properties": {
          "qutrit_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Target qutrit index"
          }
        },
        "required": ["qutrit_index"]
      }
    },
    {
      "name": "wui_apply_pauli_z",
      "description": "Apply Pauli-Z gate (clock operation in GF(3))",
      "input_schema": {
        "type": "object",
        "properties": {
          "qutrit_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Target qutrit index"
          }
        },
        "required": ["qutrit_index"]
      }
    },
    {
      "name": "wui_measure",
      "description": "Measure qutrit in computational basis (collapses to 0, 1, or 2)",
      "input_schema": {
        "type": "object",
        "properties": {
          "qutrit_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Qutrit to measure"
          },
          "await_result": {
            "type": "boolean",
            "default": true,
            "description": "Wait for measurement result"
          }
        },
        "required": ["qutrit_index"]
      }
    },
    {
      "name": "wui_set_config",
      "description": "Update system configuration parameter",
      "input_schema": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "description": "Configuration section (e.g., 'system.qgnn')"
          },
          "key": {
            "type": "string",
            "description": "Configuration key"
          },
          "value": {
            "type": ["string", "integer", "boolean", "number"],
            "description": "Configuration value"
          }
        },
        "required": ["section", "key", "value"]
      }
    },
    {
      "name": "wui_set_num_qutrits",
      "description": "Set number of qutrits for quantum operations",
      "input_schema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Number of qutrits"
          }
        },
        "required": ["count"]
      }
    },
    {
      "name": "wui_set_entanglement_graph",
      "description": "Set entanglement graph topology for QGNN",
      "input_schema": {
        "type": "object",
        "properties": {
          "graph_type": {
            "type": "string",
            "enum": ["linear", "circular", "star", "complete", "random", "grid"],
            "description": "Graph topology type"
          }
        },
        "required": ["graph_type"]
      }
    },
    {
      "name": "wui_run_inference",
      "description": "Execute inference with ternary input data",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "array",
            "items": {
              "type": "integer",
              "enum": [-1, 0, 1]
            },
            "description": "Ternary input values (-1, 0, +1)"
          },
          "timeout_ms": {
            "type": "integer",
            "default": 5000,
            "description": "Inference timeout"
          }
        },
        "required": ["input"]
      }
    },
    {
      "name": "wui_get_metrics",
      "description": "Retrieve current system metrics and status",
      "input_schema": {
        "type": "object",
        "properties": {
          "subscribe": {
            "type": "boolean",
            "default": false,
            "description": "Subscribe to continuous metrics updates"
          },
          "interval_ms": {
            "type": "integer",
            "default": 5000,
            "description": "Metrics update interval if subscribed"
          }
        }
      }
    },
    {
      "name": "wui_get_pipeline_status",
      "description": "Get CI/CD pipeline execution status",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "wui_trigger_pipeline",
      "description": "Trigger CI/CD pipeline execution",
      "input_schema": {
        "type": "object",
        "properties": {
          "pipeline_type": {
            "type": "string",
            "enum": ["build", "test", "deploy", "full"],
            "description": "Type of pipeline to trigger"
          },
          "branch": {
            "type": "string",
            "default": "main",
            "description": "Git branch to run pipeline on"
          }
        },
        "required": ["pipeline_type"]
      }
    },
    {
      "name": "wui_compute_betti",
      "description": "Compute Betti numbers for topological data analysis",
      "input_schema": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of graph nodes"
          },
          "edges": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of graph edges"
          }
        },
        "required": ["nodes", "edges"]
      }
    },
    {
      "name": "wui_init_training_pipeline",
      "description": "Initialize complete autonomous training pipeline with DataSynthesizer, 243-expert MoE, BettiExtractor, and Forward-Forward training",
      "input_schema": {
        "type": "object",
        "properties": {
          "acquisition_threads": {
            "type": "integer",
            "default": 4,
            "description": "DataSynthesizer acquisition thread count"
          },
          "num_experts": {
            "type": "integer",
            "default": 243,
            "minimum": 1,
            "maximum": 1000,
            "description": "Number of MoE experts"
          },
          "graph_nodes": {
            "type": "integer",
            "default": 64,
            "description": "Initial graph node count"
          },
          "enable_betti_guidance": {
            "type": "boolean",
            "default": true,
            "description": "Enable Betti-guided topology optimization"
          },
          "enable_knowledge_engine": {
            "type": "boolean",
            "default": true,
            "description": "Enable DataSynthesizer knowledge engine APIs"
          },
          "epochs": {
            "type": "integer",
            "default": 1000,
            "description": "Training epochs"
          },
          "batch_size": {
            "type": "integer",
            "default": 32,
            "description": "Training batch size"
          }
        }
      }
    },
    {
      "name": "wui_set_pipeline_config",
      "description": "Update training pipeline configuration",
      "input_schema": {
        "type": "object",
        "properties": {
          "batch_size": {
            "type": "integer",
            "minimum": 1,
            "description": "Training batch size"
          },
          "learning_rate": {
            "type": "number",
            "minimum": 0,
            "description": "Forward-Forward learning rate"
          },
          "betti_guidance_threshold": {
            "type": "integer",
            "description": "β₁ threshold for topology optimization"
          },
          "enable_wui_streaming": {
            "type": "boolean",
            "description": "Enable real-time metrics streaming"
          }
        }
      }
    },
    {
      "name": "wui_get_training_metrics",
      "description": "Get comprehensive training metrics from all pipeline stages including Forward-Forward, MoE, Betti numbers, graph state, and DataSynthesizer",
      "input_schema": {
        "type": "object",
        "properties": {
          "include_betti": {
            "type": "boolean",
            "default": true,
            "description": "Include Betti number analysis"
          },
          "include_graph_state": {
            "type": "boolean",
            "default": true,
            "description": "Include graph topology state"
          },
          "include_expert_stats": {
            "type": "boolean",
            "default": true,
            "description": "Include per-expert statistics"
          }
        }
      }
    },
    {
      "name": "wui_apply_betti_guidance",
      "description": "Trigger Betti-guided topology optimization to adjust quantum graph structure based on topological data analysis",
      "input_schema": {
        "type": "object",
        "properties": {
          "force": {
            "type": "boolean",
            "default": false,
            "description": "Force optimization even if below threshold"
          }
        }
      }
    },
    {
      "name": "wui_pause_training",
      "description": "Pause training pipeline (can be resumed)",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "wui_resume_training",
      "description": "Resume paused training pipeline",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "wui_export_model",
      "description": "Export QMINI_V3 training checkpoint (alias of wui_export_training_checkpoint; MoE expert weights)",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Export file path"
          },
          "include_topology": {
            "type": "boolean",
            "default": true,
            "description": "Include graph topology in export"
          }
        },
        "required": ["path"]
      }
    },
    {
      "name": "wui_import_model",
      "description": "Import QMINI_V3 checkpoint (alias of wui_import_training_checkpoint)",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Import file path"
          }
        },
        "required": ["path"]
      }
    },
    {
      "name": "wui_start_ff_training",
      "description": "Start Forward-Forward training process",
      "input_schema": {
        "type": "object",
        "properties": {
          "layers": {
            "type": "array",
            "items": {"type": "integer"},
            "description": "Layer indices to train"
          },
          "epochs": {
            "type": "integer",
            "default": 100,
            "description": "Training epochs"
          },
          "force_new_native_session": {
            "type": "boolean",
            "default": false,
            "description": "If true, destroy the existing native session before start (default: reuse session after stop to keep weights)"
          }
        }
      }
    },
    {
      "name": "wui_stop_ff_training",
      "description": "Stop Forward-Forward training process",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "wui_export_training_checkpoint",
      "description": "Export QMINI_V3 MoE checkpoint (.qmini) while training is stopped (same session as stop)",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Optional absolute path; default DataDir/checkpoints/training_<unix>.qmini"
          }
        }
      }
    },
    {
      "name": "wui_import_training_checkpoint",
      "description": "Load QMINI_V3 checkpoint into the current native session (training stopped)",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to .qmini file"
          }
        },
        "required": ["path"]
      }
    },
    {
      "name": "wui_close_training_session",
      "description": "Destroy native q_training session after stop (frees RAM; export first if you need weights)",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "wui_init_graph",
      "description": "Initialize QGNN graph with specified nodes and edges",
      "input_schema": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "integer",
            "minimum": 1,
            "default": 8,
            "description": "Number of nodes"
          },
          "edges": {
            "type": "integer",
            "minimum": 0,
            "default": 14,
            "description": "Number of edges"
          }
        }
      }
    },
    {
      "name": "wui_add_graph_node",
      "description": "Add node to QGNN graph",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "wui_add_graph_edge",
      "description": "Add edge to QGNN graph",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "wui_read_memory",
      "description": "Read bytes from shared memory at specified offset",
      "input_schema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Memory offset in bytes"
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536,
            "description": "Number of bytes to read"
          }
        },
        "required": ["offset", "length"]
      }
    },
    {
      "name": "wui_write_memory",
      "description": "Write bytes to shared memory at specified offset",
      "input_schema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Memory offset in bytes"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "description": "Bytes to write"
          }
        },
        "required": ["offset", "data"]
      }
    },
    {
      "name": "wui_build_release",
      "description": "Build single-executable desktop artifact and embed deterministic WUI asset bundle",
      "input_schema": {
        "type": "object",
        "properties": {
          "output": {
            "type": "string",
            "default": "qminiwasm_wui.exe",
            "description": "Output executable path"
          },
          "go_binary": {
            "type": "string",
            "default": "go",
            "description": "Go binary path"
          },
          "build_bridge": {
            "type": "boolean",
            "default": true,
            "description": "Build bridge binary before desktop artifact"
          },
          "require_native_runtime": {
            "type": "boolean",
            "default": true,
            "description": "Require compiled native runtime artifacts to be embedded in release bundle"
          },
          "require_cgo": {
            "type": "boolean",
            "default": true,
            "description": "Require CGO-enabled desktop build (fails when C toolchain is unavailable)"
          }
        }
      }
    },
    {
      "name": "wui_deploy_release",
      "description": "Deploy desktop artifact and verify/extract embedded asset bundle",
      "input_schema": {
        "type": "object",
        "properties": {
          "artifact_path": {
            "type": "string",
            "description": "Artifact path to deploy"
          },
          "target": {
            "type": "string",
            "default": "local",
            "description": "Deployment target identifier"
          },
          "deploy_dir": {
            "type": "string",
            "description": "Deployment directory"
          },
          "extract_dir": {
            "type": "string",
            "description": "Optional asset extraction directory"
          },
          "extract_assets": {
            "type": "boolean",
            "default": true,
            "description": "Extract embedded assets after deploy"
          },
          "require_native_runtime": {
            "type": "boolean",
            "default": true,
            "description": "Fail deploy verification if embedded native runtime assets are absent"
          }
        }
      }
    },
    {
      "name": "wui_rollback_release",
      "description": "Rollback deployed desktop artifact from backup",
      "input_schema": {
        "type": "object",
        "properties": {
          "deploy_dir": {
            "type": "string",
            "description": "Deployment directory containing backup"
          },
          "artifact_name": {
            "type": "string",
            "description": "Artifact filename to restore"
          }
        }
      }
    },
    {
      "name": "wui_get_release_status",
      "description": "Return release state + readiness diagnostics",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "wui_get_ops_snapshot",
      "description": "Return consolidated train/deploy/runtime operations snapshot",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "resources": [
    {
      "uri": "file://q_mini_wasm_v2/wui/js/mcp-host-bridge.js",
      "name": "mcp_host_bridge",
      "description": "Host-side MCP bridge implementation for desktop WUI control"
    },
    {
      "uri": "file://q_mini_wasm_v2/runtime/desktop_shell_contract.json",
      "name": "desktop_shell_contract",
      "description": "Deterministic desktop shell contract for window.qMiniMcpHost.callTool"
    },
    {
      "uri": "file://q_mini_wasm_v2/runtime/desktop_shell_bootstrap.js",
      "name": "desktop_shell_bootstrap",
      "description": "Desktop shell bootstrap bridge for WebView2 postMessage adapter"
    },
    {
      "uri": "file://q_mini_wasm_v2/runtime/embedded_asset_manifest.json",
      "name": "embedded_asset_manifest",
      "description": "Embedded WUI asset manifest generated during release build"
    },
    {
      "uri": "file://q_mini_wasm_v2/q_mini_wasm_v2/dll/q_mini_wasm_v2_api.hpp",
      "name": "dll_api",
      "description": "C++ DLL API for engine integration"
    },
    {
      "uri": "file://q_mini_wasm_v2/config/system.toml",
      "name": "system_config",
      "description": "System configuration file"
    },
    {
      "uri": "file://q_mini_wasm_v2/docs/BETTI_EXTRACTOR_TRACE.md",
      "name": "betti_extractor_docs",
      "description": "BettiExtractor code trace documentation"
    }
  ],
  "config": {
    "transport": {
      "type": "stdio",
      "description": "Standard input/output transport for MCP protocol"
    },
    "bridge": {
      "default_host": "localhost",
      "default_port": 8080,
      "session_retry_attempts": 5,
      "session_retry_delay_ms": 1000
    }
  }
}
