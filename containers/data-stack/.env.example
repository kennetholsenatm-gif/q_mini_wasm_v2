# Q-Mini-WASM Data Stack environment variables.
# Copy to .env and set values. Do not commit .env (it is in .gitignore).

# PostgreSQL (required)
POSTGRES_USER=qminiwasm
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=qminiwasm_db
POSTGRES_PORT=5432

# RabbitMQ (required)
RABBITMQ_DEFAULT_USER=qminiwasm
RABBITMQ_DEFAULT_PASS=change_me_strong_password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# NiFi (optional; defaults shown)
NIFI_JVM_HEAP_INIT=4g
NIFI_JVM_HEAP_MAX=8g
NIFI_WEB_PORT=8080
NIFI_SENSITIVE_PROPS_KEY=

# Solace PubSub+ (required if using solace-pubsub / Agent Mesh)
SOLACE_ADMIN_PASSWORD=change_me_solace_admin
SOLACE_SMF_PORT=55555
SOLACE_WEB_SOCKET_PORT=8008
SOLACE_SEMP_PORT=8080

# Solace Agent Mesh (broker connection; prefer Vault for SOLACE_BROKER_PASSWORD in production)
SOLACE_BROKER_URL=ws://solace-pubsub:8008
SOLACE_BROKER_USERNAME=admin
SOLACE_BROKER_PASSWORD=change_me_solace_admin
SOLACE_BROKER_VPN=default
SOLACE_DEV_MODE=false
SOLACE_AGENT_MESH_PORT=8000

# LLM for Agent Mesh Orchestrator (optional; set for AI task routing)
# LLM_SERVICE_ENDPOINT=
# LLM_SERVICE_API_KEY=
# LLM_SERVICE_PLANNING_MODEL_NAME=
# LLM_SERVICE_GENERAL_MODEL_NAME=
