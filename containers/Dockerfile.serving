# ML Serving / Inference API. Build from repo root.
# Exposes POST /infer and GET /health on port 8001.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml setup.py ./
COPY requirements/ requirements/
COPY qminiwasm/ qminiwasm/
COPY engine/ engine/

RUN pip install --no-cache-dir -e . \
    && pip install --no-cache-dir -r requirements/core.txt -r requirements/quantum.txt -r requirements/wasm.txt \
    && pip install --no-cache-dir "fastapi>=0.104.0" "uvicorn[standard]>=0.24.0" "pydantic>=2.0.0"

RUN groupadd -r app --gid 1000 && useradd -r -u 1000 -g app -d /app -s /sbin/nologin app \
    && chown -R app:app /app
USER app

EXPOSE 8001
CMD ["python", "-m", "uvicorn", "engine.serve:app", "--host", "0.0.0.0", "--port", "8001"]
