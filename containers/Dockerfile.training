# ML Training worker (data processing, training loop). Build from repo root.
# For GPU: use nvidia/cuda base and ensure nvidia-docker runtime.
# Volume mount dataset at /data and set DATA_PATH=/data (or ENGINE_DATA_PATH).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DATA_PATH=/data

WORKDIR /app

COPY pyproject.toml setup.py ./
COPY requirements/ requirements/
COPY qminiwasm/ qminiwasm/
COPY engine/ engine/

RUN pip install --no-cache-dir -e . \
    && pip install --no-cache-dir -r requirements/core.txt -r requirements/quantum.txt -r requirements/wasm.txt

# Optional: non-root user; ensure /data is writable when mounted
RUN groupadd -r app --gid 1000 && useradd -r -u 1000 -g app -d /app -s /sbin/nologin app \
    && mkdir -p /data && chown -R app:app /app /data
USER app

VOLUME /data
ENTRYPOINT ["python", "-m", "engine"]
