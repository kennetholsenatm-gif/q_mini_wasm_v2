# FreeIPA Server Installation Options for Hierarchical Edge-Quantum AI Architecture
# This file contains the installation options for FreeIPA server deployment

# Domain and realm configuration
--domain=qminiwasm.local
--realm=QMINIWASM.LOCAL
--hostname=ipa.qminiwasm.local

# Security and compliance settings
--ds-password=${FREEIPA_DS_PASSWORD}
--admin-password=${FREEIPA_ADMIN_PASSWORD}

# PKI configuration for STIG/CMMC 2.0 compliance
--setup-ca
--ca-subject="CN=QMiniWASM IPA CA,O=QMINIWASM.LOCAL"
--subject="CN=IPA Certificate Authority,O=QMINIWASM.LOCAL"

# DNS configuration for edge environments
--no-forwarders
--no-reverse
--auto-reverse

# NTP configuration
--no-ntp

# SSH configuration
--no-ssh
--no-sshfp

# Sudo configuration
--no-sudo

# Trust configuration
--no-hbac-allow

# Client configuration
--mkhomedir

# Security hardening
--enable-compat
--enable-migration

# Kerberos configuration
--kdc-enable-lookaside-cache

# Web UI configuration
--setup-dns
--allow-zone-overlap