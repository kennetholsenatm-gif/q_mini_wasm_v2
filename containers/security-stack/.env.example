# Zero Trust Security Stack. Copy to .env and set values. Do not commit .env.

# Keycloak database
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me_strong_password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_PORT=8080

# Keycloak admin (bootstrap)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_strong_password

# Vault (dev mode; production must use real seal and token — see docs/Vault-Production.md)
VAULT_DEV_ROOT_TOKEN_ID=root
VAULT_PORT=8200

# Envoy (TLS 1.3 + PQC). Place server cert/key in TLS_CERT_PATH (e.g. proxy/certs/).
TLS_CERT_PATH=./proxy/certs
ENVOY_HTTPS_PORT=8443
ENVOY_HTTP_PORT=8081

# FreeIPA Configuration (Hierarchical Edge-Quantum AI Architecture)
# Domain and realm configuration
FREEIPA_DOMAIN=qminiwasm.local
FREEIPA_REALM=QMINIWASM.LOCAL
FREEIPA_SERVER_HOSTNAME=ipa.qminiwasm.local

# FreeIPA administrative credentials (required for setup)
FREEIPA_ADMIN_PASSWORD=change_me_strong_password
FREEIPA_DS_PASSWORD=change_me_strong_password

# FreeIPA service ports (for edge environments)
FREEIPA_HTTP_PORT=8080
FREEIPA_HTTPS_PORT=8443
FREEIPA_LDAP_PORT=389
FREEIPA_LDAPS_PORT=636
FREEIPA_KDC_PORT=88
FREEIPA_KPASSWD_PORT=464
FREEIPA_DNS_PORT=53
FREEIPA_NTP_PORT=123

# FreeIPA integration with Keycloak
FREEIPA_INTEGRATION_SECRET=change_me_integration_secret

# FreeIPA PKI Certificate Configuration
FREEIPA_CA_SUBJECT=CN=QMiniWASM IPA CA,O=QMINIWASM.LOCAL
FREEIPA_CERT_VALIDITY_DAYS=365
FREEIPA_CERT_KEY_SIZE=2048

# Edge Gateway and Quantum Router Configuration
EDGE_GATEWAY_SUBNET=172.20.0.0/16
QUANTUM_ROUTER_HOSTNAME=router.qminiwasm.local
EDGE_GATEWAY_HOSTNAME_TEMPLATE=gateway{num}.edge.qminiwasm.local
