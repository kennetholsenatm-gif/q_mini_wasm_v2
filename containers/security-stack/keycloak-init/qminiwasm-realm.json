{
  "realm": "qminiwasm",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "roles": { "realm": [{ "name": "user" }, { "name": "dev-read-only" }, { "name": "dev-admin" }] },
  "clients": [
    {
      "clientId": "teleport",
      "name": "Teleport OIDC",
      "description": "OIDC client for Teleport IdP integration",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "redirectUris": ["https://teleport.example.com/callback", "https://localhost:3080/callback"],
      "webOrigins": ["+"],
      "attributes": { "post.logout.redirect.uris": "https://teleport.example.com/*" }
    }
  ],
  "browserFlow": "browser",
  "registrationFlow": "registration",
  "directGrantFlow": "direct grant",
  "resetCredentialsFlow": "reset credentials",
  "clientAuthenticationFlow": "clients",
  "webAuthnPolicyPasswordlessRpEntityName": "Q-Mini-WASM",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "requiredActions": [
    { "alias": "webauthn-register-passwordless", "name": "WebAuthn Passwordless Register", "enabled": true }
  ]
}
