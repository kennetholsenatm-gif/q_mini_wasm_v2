# qminiwasm-core — Varlock / docs schema for .env
#
# POLICY: This file lists ONLY secrets, API keys, and credentials read from the environment.
# Application configuration (training, serve, WASM, accelerators, telemetry) lives in TOML
# and the Training WUI — see configs/training/schema.toml and docs/ENV_CI_OVERRIDES.md.
#
# Do not add batch sizes, WASM limits, or feature toggles here.

# Hugging Face Hub
@env-spec
@type string
@description API token for Hugging Face Hub (gated datasets, higher rate limits)
@sensitive true
HUGGING_FACE_HUB_TOKEN=

@env-spec
@type string
@description Alias for Hugging Face Hub token (some tools expect HF_TOKEN)
@sensitive true
HF_TOKEN=

# IBM Quantum / Qiskit
@env-spec
@type string
@description IBM Quantum Platform API token (Qiskit Runtime)
@sensitive true
IBM_QUANTUM_API_TOKEN=

@env-spec
@type string
@description Qiskit IBM Runtime token (alternate name)
@sensitive true
QISKIT_IBM_TOKEN=

# RunPod
@env-spec
@type string
@description RunPod account API key (OpenTofu / management)
@sensitive true
RUNPOD_TOKEN=

@env-spec
@type string
@description RunPod API key (alias for account key)
@sensitive true
RUNPOD_API_KEY=

@env-spec
@type string
@description RunPod serverless endpoint API key (queue /run)
@sensitive true
RUNPOD_TOKEN_END=

@env-spec
@type string
@description RunPod serverless endpoint ID
@sensitive false
RUNPOD_SERVERLESS_ENDPOINT_ID=
