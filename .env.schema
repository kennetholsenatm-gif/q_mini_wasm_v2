# Environment Variables Schema for LLM Pract
# Generated from .env.example using Varlock format
# This file defines the structure and validation rules for environment variables

# IBM Quantum API Configuration
@env-spec
@type string
@description IBM Quantum API key for accessing quantum services
@sensitive true
IBM_QUANTUM_API_KEY=your_ibm_quantum_api_key_here

@env-spec
@type url
@description IBM Quantum API endpoint URL
IBM_QUANTUM_URL=https://quantum-computing.ibm.com/api

# Qiskit Configuration
@env-spec
@type boolean
@description Whether to save Qiskit account credentials
@default true
QISKIT_SAVE_ACCOUNT=True

@env-spec
@type boolean
@description Whether to load Qiskit account credentials
@default true
QISKIT_LOAD_ACCOUNT=True

# Quantum Simulation Settings
@env-spec
@type string
@description Quantum simulator backend to use (e.g., AerSimulator)
@default AerSimulator
QUANTUM_SIMULATOR=AerSimulator

@env-spec
@type number
@description Number of shots for quantum circuit execution
@default 1024
QUANTUM_SHOTS=1024

@env-spec
@type number
@description Random seed for quantum simulation (optional)
QUANTUM_SEED=None

# WASM Configuration
@env-spec
@type string
@description WASM runtime to use (e.g., wasmtime)
@default wasmtime
WASM_RUNTIME=wasmtime

@env-spec
@type string
@description Directory for WASM cache files
@default .wasm_cache
WASM_CACHE_DIR=.wasm_cache

@env-spec
@type number
@description Maximum memory allocation for WASM runtime in MB
@default 4096
WASM_MAX_MEMORY=4096

# Intel ARC (XPU) / GPU Configuration — used for AI training (CUDA not used)
@env-spec
@type number
@description Intel GPU device ID
@default 0
INTEL_GPU_DEVICE=0

@env-spec
@type number
@description Intel GPU memory allocation in MB
@default 8192
INTEL_GPU_MEMORY=8192

@env-spec
@type number
@description Number of threads for Intel GPU processing
@default 16
INTEL_GPU_THREADS=16

@env-spec
@type boolean
@description Set to 0 to force CPU even when XPU is available, 1 to prefer XPU
@default true
PREFER_XPU=1

# Cloud Configuration
@env-spec
@type string
@description Cloud provider (e.g., aws, azure, gcp)
@default aws
CLOUD_PROVIDER=aws

@env-spec
@type string
@description AWS access key ID for cloud services
@sensitive true
AWS_ACCESS_KEY_ID=your_aws_access_key_id

@env-spec
@type string
@description AWS secret access key for cloud services
@sensitive true
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

@env-spec
@type string
@description AWS region for cloud services
@default us-west-2
AWS_REGION=us-west-2

# Database Configuration
@env-spec
@type string
@description PostgreSQL database connection URL
@default postgresql://user:password@localhost:5432/llm_pract
DATABASE_URL=postgresql://user:password@localhost:5432/llm_pract

@env-spec
@type string
@description Redis connection URL
@default redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Monitoring Configuration
@env-spec
@type number
@description Prometheus metrics server port
@default 9090
PROMETHEUS_PORT=9090

@env-spec
@type number
@description Grafana web interface port
@default 3000
GRAFANA_PORT=3000

@env-spec
@type number
@description Node exporter metrics port
@default 9100
NODE_EXPORTER_PORT=9100

# Docker (optional — for Windows or when Docker is not on PATH)
@env-spec
@type string
@description Path to Docker executable (leave empty to use Docker from PATH)
DOCKER_PATH=

# Development Settings
@env-spec
@type boolean
@description Enable debug mode for development
@default true
DEBUG=True

@env-spec
@type string
@description Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
@default INFO
LOG_LEVEL=INFO

@env-spec
@type number
@description Maximum number of worker processes
@default 4
MAX_WORKERS=4

@env-spec
@type number
@description Application server port
@default 8000
PORT=8000

# Security Settings (never commit real values; use a secrets manager in production)
@env-spec
@type string
@description Application secret key for session management
@sensitive true
SECRET_KEY=your_secret_key_here

@env-spec
@type string
@description JWT secret key for token authentication
@sensitive true
JWT_SECRET=your_jwt_secret_here

@env-spec
@type string
@description Encryption key for data protection
@sensitive true
ENCRYPTION_KEY=your_encryption_key_here

# Performance Settings
@env-spec
@type number
@description Maximum number of tokens for processing
@default 5000000
MAX_TOKENS=5000000

@env-spec
@type number
@description Batch size for processing operations
@default 32
BATCH_SIZE=32

@env-spec
@type number
@description Worker timeout in seconds
@default 300
WORKER_TIMEOUT=300

@env-spec
@type number
@description Number of retry attempts for failed operations
@default 3
RETRY_ATTEMPTS=3

# Intel Arc GPU Cloud (when available)
@env-spec
@type url
@description Intel Arc cloud endpoint URL
@default arc.intel.com
INTEL_CLOUD_ENDPOINT=arc.intel.com

@env-spec
@type string
@description Intel Arc cloud API key
@sensitive true
INTEL_CLOUD_API_KEY=your_intel_cloud_api_key

@env-spec
@type string
@description Intel Arc cloud project ID
INTEL_CLOUD_PROJECT_ID=your_project_id

# Intel Quantum (optional — Intel Quantum SDK / Intel QS)
@env-spec
@type string
@description Path to Intel Quantum SDK installation
INTEL_QUANTUM_SDK_PATH=

@env-spec
@type string
@description Python interpreter for Intel QS
INTEL_QS_PYTHON=