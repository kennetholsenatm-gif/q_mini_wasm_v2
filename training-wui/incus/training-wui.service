[Unit]
Description=QMiniWASM training web UI (training-wui)
Documentation=file:/opt/qmw/training-wui/README.md
# Containers: avoid network-online (can block); bind mount must be ready before ExecStart.
After=network.target local-fs.target
Wants=network.target

[Service]
Type=simple
# Wait for Incus host repo bind mount + built binary (race on first seconds after boot).
ExecStartPre=/bin/bash -c 'for i in $(seq 1 120); do test -x /opt/wui/training-wui && test -d /opt/qmw/engine && exit 0; sleep 1; done; echo "training-wui: timeout waiting for /opt/qmw or /opt/wui/training-wui" >&2; exit 1'
ExecStart=/opt/wui/training-wui -root /opt/qmw -addr 0.0.0.0:8765 -python python3
WorkingDirectory=/opt/qmw
Restart=always
RestartSec=5
Environment=HOME=/root
# OpenTofu installer uses /usr/local/bin/tofu; ensure subprocesses see it.
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin

[Install]
WantedBy=multi-user.target
